# Copy this file to .env. The real .env is ignored by Git.
# Use "responses" after filling model, endpoint, and key.
# Leave "extractive" for fully offline operation.
AUTOMANUAL_GENERATION_BACKEND=extractive
AUTOMANUAL_GENERATION_MODEL=your-vlm-model-name
AUTOMANUAL_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_API_KEY=replace-with-your-key

# Qwen settings. API keys and endpoints must belong to the same region.
# This example uses an EU workspace in Germany (Frankfurt).
DASHSCOPE_API_KEY=replace-with-your-dashscope-key
QWEN_MODEL=qwen3-vl-flash
DASHSCOPE_CHAT_COMPLETIONS_URL=https://YOUR_WORKSPACE_ID.eu-central-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions
